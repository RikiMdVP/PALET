# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key (required): LLM calls in ARQ, QSP, MAP and synthesis
ANTHROPIC_API_KEY=

# OpenAlex API key (required since February 2026; free at openalex.org/settings/api)
OPENALEX_API_KEY=

# Contact e-mail sent to PubMed/NCBI with each request (optional, recommended)
CONTACT_EMAIL=

# Elsevier/Scopus API key (optional; Scopus integration pending)
ELSEVIER_API_KEY=
